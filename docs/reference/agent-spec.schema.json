{
  "$defs": {
    "Acceptance": {
      "additionalProperties": false,
      "properties": {
        "min_pass_rate": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Pass Rate",
          "type": "number"
        },
        "required_cases": {
          "items": {
            "type": "string"
          },
          "title": "Required Cases",
          "type": "array"
        },
        "mandatory_kinds": {
          "description": "Case kinds that must all pass regardless of min_pass_rate (security cases by default).",
          "items": {
            "enum": [
              "functional",
              "input_validation",
              "output_schema",
              "tool_selection",
              "tool_invocation",
              "permission",
              "prompt_injection",
              "workflow_recovery",
              "timeout",
              "model_failure",
              "regression",
              "performance",
              "human_review"
            ],
            "type": "string"
          },
          "title": "Mandatory Kinds",
          "type": "array"
        },
        "max_avg_latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Avg Latency Ms"
        },
        "max_p95_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max P95 Latency Ms"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total model cost of the run.",
          "title": "Max Cost Usd"
        },
        "regression": {
          "default": "block",
          "description": "Cases that pass in the published version and fail in this one: block release, warn, or ignore.",
          "enum": [
            "block",
            "warn",
            "off"
          ],
          "title": "Regression",
          "type": "string"
        },
        "judge": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Acceptance",
      "type": "object"
    },
    "AgentMemory": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_items": {
          "default": 50,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        }
      },
      "title": "AgentMemory",
      "type": "object"
    },
    "AgentSpecBody": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "maxLength": 4000,
          "minLength": 8,
          "title": "Objective",
          "type": "string"
        },
        "instructions": {
          "default": "",
          "maxLength": 50000,
          "title": "Instructions",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelSpec"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": true,
          "title": "Outputs",
          "type": "object"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolRef"
          },
          "title": "Tools",
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentRef"
          },
          "title": "Components",
          "type": "array"
        },
        "workflow": {
          "$ref": "#/$defs/WorkflowSpec"
        },
        "memory": {
          "$ref": "#/$defs/MemorySpec"
        },
        "execution_limits": {
          "$ref": "#/$defs/ExecutionLimits"
        },
        "policies": {
          "$ref": "#/$defs/Policies"
        },
        "human_approval": {
          "$ref": "#/$defs/HumanApproval"
        },
        "evaluation": {
          "$ref": "#/$defs/EvaluationSpec"
        }
      },
      "required": [
        "objective"
      ],
      "title": "AgentSpecBody",
      "type": "object"
    },
    "ComponentRef": {
      "additionalProperties": false,
      "description": "A pinned reference to a registered component. Versions are mandatory: no silent replacement.",
      "properties": {
        "kind": {
          "enum": [
            "prompt_template",
            "system_instruction",
            "tool_definition",
            "workflow_node",
            "validation_rule",
            "retrieval_component",
            "model_profile",
            "policy_definition",
            "evaluation_dataset"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_\\-]{1,119}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "ConversationMemory": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_messages": {
          "default": 20,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Messages",
          "type": "integer"
        }
      },
      "title": "ConversationMemory",
      "type": "object"
    },
    "EvalCaseSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "default": "functional",
          "enum": [
            "functional",
            "input_validation",
            "output_schema",
            "tool_selection",
            "tool_invocation",
            "permission",
            "prompt_injection",
            "workflow_recovery",
            "timeout",
            "model_failure",
            "regression",
            "performance",
            "human_review"
          ],
          "title": "Kind",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "expected": {
          "$ref": "#/$defs/EvalExpectation"
        },
        "model_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval_decision": {
          "default": "none",
          "enum": [
            "approve",
            "reject",
            "none"
          ],
          "title": "Approval Decision",
          "type": "string"
        },
        "limits_override": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limits Override"
        },
        "fault_injection": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deterministic faults, e.g. {'fail_tool_once': 'read_pipeline_logs'}.",
          "title": "Fault Injection"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "EvalCaseSpec",
      "type": "object"
    },
    "EvalExpectation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "completed",
          "title": "Status"
        },
        "output_schema_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema Valid"
        },
        "output_contains": {
          "items": {
            "type": "string"
          },
          "title": "Output Contains",
          "type": "array"
        },
        "output_not_contains": {
          "items": {
            "type": "string"
          },
          "title": "Output Not Contains",
          "type": "array"
        },
        "output_fields": {
          "additionalProperties": true,
          "description": "Dotted path \u2192 expected value or {min_items|contains|equals}.",
          "title": "Output Fields",
          "type": "object"
        },
        "tools_called": {
          "items": {
            "type": "string"
          },
          "title": "Tools Called",
          "type": "array"
        },
        "tools_not_called": {
          "items": {
            "type": "string"
          },
          "title": "Tools Not Called",
          "type": "array"
        },
        "tools_denied": {
          "items": {
            "type": "string"
          },
          "title": "Tools Denied",
          "type": "array"
        },
        "approval_requested": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Requested"
        },
        "max_latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Latency Ms"
        },
        "max_model_calls": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Calls"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        }
      },
      "title": "EvalExpectation",
      "type": "object"
    },
    "EvaluationSpec": {
      "additionalProperties": false,
      "properties": {
        "suite": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of a registered evaluation suite.",
          "title": "Suite"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/EvalCaseSpec"
          },
          "title": "Cases",
          "type": "array"
        },
        "security_suite": {
          "default": false,
          "description": "Add the platform's reusable security cases (compromised model, injected input) to the suite.",
          "title": "Security Suite",
          "type": "boolean"
        },
        "acceptance": {
          "$ref": "#/$defs/Acceptance"
        }
      },
      "title": "EvaluationSpec",
      "type": "object"
    },
    "ExecutionLimits": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "default": 20,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_model_calls": {
          "default": 20,
          "maximum": 1000,
          "minimum": 0,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 30,
          "maximum": 1000,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "max_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "max_total_retries": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Retry budget for the whole execution (model, tool and validation retries).",
          "title": "Max Total Retries"
        },
        "max_context_tokens": {
          "default": 16000,
          "maximum": 2000000,
          "minimum": 256,
          "title": "Max Context Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 2048,
          "maximum": 200000,
          "minimum": 16,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_subagents": {
          "default": 4,
          "maximum": 20,
          "minimum": 0,
          "title": "Max Subagents",
          "type": "integer"
        }
      },
      "title": "ExecutionLimits",
      "type": "object"
    },
    "HumanApproval": {
      "additionalProperties": false,
      "properties": {
        "required_for_risk": {
          "items": {
            "$ref": "#/$defs/RiskLevel"
          },
          "title": "Required For Risk",
          "type": "array"
        },
        "require_for_writes": {
          "default": true,
          "title": "Require For Writes",
          "type": "boolean"
        },
        "expires_after_seconds": {
          "default": 86400,
          "maximum": 2592000,
          "minimum": 60,
          "title": "Expires After Seconds",
          "type": "integer"
        },
        "approver_roles": {
          "items": {
            "type": "string"
          },
          "title": "Approver Roles",
          "type": "array"
        }
      },
      "title": "HumanApproval",
      "type": "object"
    },
    "JudgeCriterion": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,59}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Description",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "JudgeCriterion",
      "type": "object"
    },
    "JudgeSpec": {
      "additionalProperties": false,
      "description": "LLM-as-judge: an additional, advisory quality signal from an independent model.\n\nIt never changes a case's deterministic result. With ``min_score`` set, a low average score blocks release;\na judge failure counts as no score (fail closed).",
      "properties": {
        "model": {
          "$ref": "#/$defs/ModelSpec"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/JudgeCriterion"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "min_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Score"
        },
        "cases": {
          "description": "Case ids to judge; empty = every graded case.",
          "items": {
            "type": "string"
          },
          "title": "Cases",
          "type": "array"
        }
      },
      "required": [
        "model",
        "criteria"
      ],
      "title": "JudgeSpec",
      "type": "object"
    },
    "KnowledgeMemory": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "collections": {
          "items": {
            "type": "string"
          },
          "title": "Collections",
          "type": "array"
        },
        "top_k": {
          "default": 5,
          "maximum": 50,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "min_score": {
          "default": 0.0,
          "minimum": 0,
          "title": "Min Score",
          "type": "number"
        }
      },
      "title": "KnowledgeMemory",
      "type": "object"
    },
    "MemorySpec": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shorthand: false disables all memory.",
          "title": "Enabled"
        },
        "conversation": {
          "$ref": "#/$defs/ConversationMemory"
        },
        "agent": {
          "$ref": "#/$defs/AgentMemory"
        },
        "knowledge": {
          "$ref": "#/$defs/KnowledgeMemory"
        }
      },
      "title": "MemorySpec",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Stable slug, unique per workspace.",
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Name",
          "type": "string"
        },
        "display_name": {
          "default": "",
          "maxLength": 200,
          "title": "Display Name",
          "type": "string"
        },
        "version": {
          "default": "0.1.0",
          "description": "Semantic version of this specification.",
          "title": "Version",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template the spec was derived from (name@version).",
          "title": "Template"
        }
      },
      "required": [
        "name"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "ModelSpec": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "mock",
          "description": "Model provider id: mock, ollama, openai_compatible, anthropic.",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "default": "mock-default",
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional registered model profile name.",
          "title": "Profile"
        },
        "temperature": {
          "default": 0.0,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "maximum": 200000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "required_capabilities": {
          "items": {
            "enum": [
              "chat",
              "tools",
              "structured_output",
              "streaming",
              "vision",
              "embeddings"
            ],
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_retries": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides execution_limits.max_retries.",
          "title": "Max Retries"
        }
      },
      "title": "ModelSpec",
      "type": "object"
    },
    "Policies": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "external_network": {
          "default": false,
          "title": "External Network",
          "type": "boolean"
        },
        "allowed_network_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Network Hosts",
          "type": "array"
        },
        "allow_write_operations": {
          "default": false,
          "title": "Allow Write Operations",
          "type": "boolean"
        },
        "require_approval_for": {
          "items": {
            "type": "string"
          },
          "title": "Require Approval For",
          "type": "array"
        },
        "data_classification": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Data Classification",
          "type": "string"
        },
        "capture_content": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override platform content capture for this agent.",
          "title": "Capture Content"
        }
      },
      "title": "Policies",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "Specialist": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "agent": {
          "description": "Agent reference name[@version]. Must be built and executable.",
          "title": "Agent",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 1000,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "agent"
      ],
      "title": "Specialist",
      "type": "object"
    },
    "ToolRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "max_retries": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides execution_limits.max_retries (idempotent tools only).",
          "title": "Max Retries"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolRef",
      "type": "object"
    },
    "WorkflowSpec": {
