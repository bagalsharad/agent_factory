# Copy to production.env (never commit it). Values here are examples, not defaults to keep.
COMPOSE_PROJECT_NAME=agent-factory
POSTGRES_USER=agentfactory
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=agentfactory
AF_DOMAIN=localhost

AF_PROFILE=production
AF_AUTH_MODE=api_key
AF_ALLOW_SELF_APPROVAL=false
AF_HOST=0.0.0.0
AF_CORS_ORIGINS=[]
AF_LOG_LEVEL=INFO
AF_CAPTURE_CONTENT=false
AF_RETENTION_DAYS=30
AF_TELEMETRY_EXPORTER=none
# AF_TELEMETRY_EXPORTER=otlp
# AF_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# Model providers (local-first). Inside the compose stack: --profile ollama
AF_OLLAMA_ENABLED=true
AF_OLLAMA_BASE_URL=http://ollama:11434
AF_CLOUD_PROVIDERS_ENABLED=false

# OIDC (instead of api_key):
# AF_AUTH_MODE=oidc
# AF_OIDC_ISSUER=https://login.example.com/
# AF_OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
# AF_OIDC_AUDIENCE=agent-factory
