# Agent Factory configuration (copy to .env for local overrides; never commit .env).
# Every setting is optional; defaults are safe for a single developer on a Mac.

# --- Profile & network ---------------------------------------------------------
AF_PROFILE=local                  # local | production
AF_HOST=127.0.0.1                 # local auth mode refuses non-loopback addresses
AF_PORT=8787
AF_DATA_DIR=./data
# AF_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agentfactory

# --- Authentication -------------------------------------------------------------
AF_AUTH_MODE=local                # local | api_key | oidc
AF_ALLOW_SELF_APPROVAL=true       # set false for separation of duties (required in production)
# AF_OIDC_ISSUER=https://login.example.com/
# AF_OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
# AF_OIDC_AUDIENCE=agent-factory
# AF_OIDC_ROLES_CLAIM=af_roles

# --- Model providers (local-first; cloud is opt-in) -----------------------------
AF_DEFAULT_PROVIDER=mock
AF_DEFAULT_MODEL=mock-default
AF_OLLAMA_ENABLED=true
AF_OLLAMA_BASE_URL=http://127.0.0.1:11434
AF_OPENAI_COMPAT_ENABLED=false
AF_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:1234/v1
# AF_OPENAI_COMPAT_API_KEY=
AF_CLOUD_PROVIDERS_ENABLED=false  # must be true before any prompt can leave this machine
# AF_ANTHROPIC_API_KEY=           # requires `uv sync --extra anthropic`
AF_MODEL_TIMEOUT_SECONDS=120

# --- Execution ------------------------------------------------------------------
AF_WORKER_MODE=embedded           # embedded | external (run `agent-factory worker`)
AF_WORKER_CONCURRENCY=2
AF_APPROVAL_EXPIRY_SECONDS=86400
AF_EXECUTION_RATE_LIMIT_PER_MINUTE=60

# --- Tools & connectors ---------------------------------------------------------
# AF_KNOWLEDGE_DIR=./data/knowledge      # approved document ingestion root
# AF_NETWORK_ALLOWLIST=api.example.com   # platform-wide REST connector allowlist (comma separated)
AF_ALLOW_PRIVATE_NETWORK=false
AF_SANDBOX_BACKEND=none           # none | docker  (code execution is refused without a sandbox)
# AF_DISABLED_TOOLS=http_get

# --- Observability & data protection --------------------------------------------
AF_LOG_LEVEL=INFO
AF_LOG_JSON=true
AF_TELEMETRY_EXPORTER=none        # none | console | otlp
# AF_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# AF_CAPTURE_CONTENT=true         # default: true for local, false for production
AF_RETENTION_DAYS=30

# --- Secrets --------------------------------------------------------------------
AF_SECRETS_BACKEND=env            # env (AF_SECRET_<NAME>) | keyring | file
